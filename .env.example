# Copy this file to .env and fill in your key.
# Get a key at https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_api_key_here
# Optional: override the legacy Gemini vision detector model.
# GEMINI_MODEL=gemini-2.5-flash
#
# Optional: model used by the --ai-priority urgency evaluator (default below).
# GEMINI_PRIORITY_MODEL=gemini-2.5-pro
#
# Optional overrides for the default YOLO road-damage model + the hazard DB path.
# YOLO_REPO=Nothingger/RDD_YOLO_pretrained
# YOLO_FILE=YOLOv11x_RDD_Trained.pt
# HAZARD_DB_PATH=hazard_db.json
#
# --- Operations database backend (server/) ---
# Leave unset to use the local JSON store (data/occurrences.json).
# Set these to use hosted Supabase Postgres instead (see docs/SUPABASE_SETUP.md).
# The service_role key stays server-side; never expose it to the browser.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SERVICE_KEY=<service_role key>
# SUPABASE_TABLE=occurrences
